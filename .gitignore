# Default deny: version only the converter, synthetic test code and reviewed docs.
/*
!/.gitignore
!/README.md
!/vercel.json
!/personalizador-local/
!/tests/
!/docs/

/personalizador-local/*
!/personalizador-local/index.html
!/personalizador-local/app.js
!/personalizador-local/core.js
!/personalizador-local/core.test.cjs
!/personalizador-local/spec.js
!/personalizador-local/style.css
!/personalizador-local/serve.py
!/personalizador-local/pipeline.js
!/personalizador-local/pipeline.test.cjs
!/personalizador-local/prepare-local-data.py
!/personalizador-local/app.test.cjs
!/personalizador-local/analytics.js
!/personalizador-local/analytics.test.cjs
!/personalizador-local/prepare-public.py
!/personalizador-local/season-assets.js
!/personalizador-local/season-recipe.js
!/personalizador-local/season-provenance.json
!/personalizador-local/season.test.cjs
!/personalizador-local/prepare-season-recipe.py

/tests/*
!/tests/browser.cjs
!/tests/verify_output.py
!/tests/audit_staged.py
!/tests/metrics-browser.cjs
!/tests/public_package_test.py

/docs/*
!/docs/TECHNICAL.md
!/docs/VALIDATION.md
!/docs/PUBLISHING.md

# Never version local ROMs, extracted art, generated output or private artifacts.
**/node_modules/
**/__pycache__/
**/.env*
**/*.bin
**/*.gen
**/*.smd
**/*.rom
**/*.ips
**/*.bps
**/*.xdelta
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.zip
**/*.log
**/*.pem
**/*.key
**/*.oesavestate/

# Private 2026 delta contains game graphics; never publish or force-add it.
/private-local/
/personalizador-local/local-grid2026-data.js
